<%
const publicCount = Number(nPublic);
const powerValue = Number(power);
const domainSize = 2 ** powerValue;
const nLagrange = Math.max(publicCount, 1);
const publicContractName =
  typeof contractName === "string" && contractName.trim() !== ""
    ? contractName.trim()
    : "Verifier";
const storageName = `${publicContractName}Storage`;
const errorsName = `${publicContractName}Errors`;
const errPublicNotPresent = `${errorsName}.PublicNotPresent`;
const errFailedInverse = `${errorsName}.FailedInverse`;
const errScalarNotInField = `${errorsName}.ScalarNotInField`;
const errTooManyPublics = `${errorsName}.TooManyPublics`;
const errInvalidMessage = `${errorsName}.InvalidMessage`;
const errInvalidProof = `${errorsName}.InvalidProof`;
const errNotEnoughValue = `${errorsName}.NotEnoughValue`;

const xinSquares = Array.from(
  { length: powerValue },
  () => "  xin = mulmod(xin, xin, blsR());",
).join("\n");
const inverseSeedLines = Array.from({ length: nLagrange }, (_, index) => {
  const i = index + 1;
  const lines = [
    `  invs.setAt(${i}, mulmod(DOMAIN_SIZE, normalizeMod(xi - w, blsR()), blsR()));`,
  ];
  if (i < nLagrange) {
    lines.push("  w = mulmod(w, W1, blsR());");
  }
  return lines.join("\n");
}).join("\n");
const lagrangeEvalLines = Array.from({ length: nLagrange }, (_, index) => {
  const i = index + 1;
  const lines = [
    i === 1
      ? "  val evalL1: int = mulmod(invd.read(1), zh, blsR());"
      : `  restEvals.setAt(${i}, mulmod(w, mulmod(invd.read(${i}), zh, blsR()), blsR()));`,
  ];
  if (i < nLagrange) {
    lines.push("  w = mulmod(w, W1, blsR());");
  }
  return lines.join("\n");
}).join("\n");
const publicInputEvalLines = Array.from({ length: publicCount }, (_, i) => {
  if (i === 0) {
    return "  pl = normalizeMod(pl - mulmod(evalL1, publicInputs.read(0), blsR()), blsR());";
  }
  return `  pl = normalizeMod(pl - mulmod(restEvals.read(${i + 1}), publicInputs.read(${i}), blsR()), blsR());`;
}).join("\n");
%>
contract <%= publicContractName %> {
  description: "PLONK verifier generated by export-ton-verifier"
  storage: <%= storageName %>
  incomingMessages: VerifyProofMessage
}

/// Empty persistent storage; verifier constants are embedded in code.
struct <%= storageName %> {}

type ScalarArray = array<uint256>
type G1Compressed = bits384

/// Internal message that verifies a PLONK proof and aborts unless it is valid.
struct (0x76524659) VerifyProofMessage {
  proof: Cell<VerifyProofPayload>
}

/// PLONK proof payload split into refs to stay within TON cell limits.
struct VerifyProofPayload {
  compressed: Cell<CompressedProof>
  evaluations: Cell<EvaluationValues>
  publicInputs: ScalarArray
  uncompressed: Cell<UncompressedProof>
}

struct CompressedPair {
  first: G1Compressed
  second: G1Compressed
}

struct CompressedTail {
  t3Wxi: Cell<CompressedPair>
  wxiw: Cell<G1Compressed>
}

struct CompressedProof {
  ab: Cell<CompressedPair>
  cz: Cell<CompressedPair>
  t12: Cell<CompressedPair>
  tail: Cell<CompressedTail>
}

struct EvaluationAbc {
  evalA: uint256
  evalB: uint256
  evalC: uint256
}

struct EvaluationRest {
  evalS1: uint256
  evalS2: uint256
  evalZw: uint256
}

struct EvaluationValues {
  abc: Cell<EvaluationAbc>
  rest: Cell<EvaluationRest>
}

struct UncompressedTail2 {
  t3: cell
  wxi: cell
  wxiw: cell
}

struct UncompressedTail {
  z: cell
  t1: cell
  t2: cell
  tail: Cell<UncompressedTail2>
}

struct UncompressedProof {
  a: cell
  b: cell
  c: cell
  tail: Cell<UncompressedTail>
}

// Compressed G1 points for BLS operations (48 bytes each).
const QM: slice = "<%= Qm %>".hexToSlice()
const QL: slice = "<%= Ql %>".hexToSlice()
const QR: slice = "<%= Qr %>".hexToSlice()
const QO: slice = "<%= Qo %>".hexToSlice()
const QC: slice = "<%= Qc %>".hexToSlice()
const S1: slice = "<%= S1 %>".hexToSlice()
const S2: slice = "<%= S2 %>".hexToSlice()
const S3: slice = "<%= S3 %>".hexToSlice()
const X_2: slice = "<%= X_2 %>".hexToSlice()

// Uncompressed G1 points for the snarkjs-compatible Keccak256 transcript.
const QM_UC: slice = "<%= Qm_uc %>".hexToSlice()
const QL_UC: slice = "<%= Ql_uc %>".hexToSlice()
const QR_UC: slice = "<%= Qr_uc %>".hexToSlice()
const QO_UC: slice = "<%= Qo_uc %>".hexToSlice()
const QC_UC: slice = "<%= Qc_uc %>".hexToSlice()
const S1_UC: slice = "<%= S1_uc %>".hexToSlice()
const S2_UC: slice = "<%= S2_uc %>".hexToSlice()
const S3_UC: slice = "<%= S3_uc %>".hexToSlice()

const K1: int = <%= k1 %>
const K2: int = <%= k2 %>
const W1: int = <%= w %>

const N_PUBLIC: int = <%= publicCount %>
const DOMAIN_SIZE: int = <%= domainSize %>
const N_LAGRANGE: int = <%= nLagrange %>
const MIN_VERIFY_VALUE: coins = 70000000

const BLS_G1: slice = "97f1d3a73197d7942695638c4fa9ac0fc3688c4f9774b905a14e3a3f171bac586c55e83ff97a1aeffb3af00adb22c6bb".hexToSlice()
const BLS_G2: slice = "93e02b6052719f607dacd3a088274f65596bd0d09920b61ab5da61bbdc7f5049334cf11213945d57e5ac7d055d042b7e024aa2b2f08f0a91260805272dc51051c6e47ad4fa403b02b4510b647ae3d1770bac0326a805bbefd48056c8c121bdb8".hexToSlice()

enum <%= errorsName %> {
  PublicNotPresent = 101,
  FailedInverse = 102,
  ScalarNotInField = 103,
  TooManyPublics = 104,
  InvalidMessage = 105,
  InvalidProof = 106,
  NotEnoughValue = 107,
}

/// # Safety
/// Expects two BLS12-381 G1/G2 pairs in the order required by TVM `BLS_PAIRING`.
@pure
fun blsPairing(ag1: slice, ag2: slice, bg1: slice, bg2: slice): int asm "2 PUSHINT BLS_PAIRING";

/// # Safety
/// Keccak256 transcript hash compatible with snarkjs PLONK.
/// Expects `p` to contain at most 255 transcript items in the exact snarkjs order.
@pure
fun keccak256Tuple(p: array<slice>): int asm "255 PUSHINT EXPLODEVAR HASHEXT_KECCAK256";

/// # Safety
/// Reads the TVM BLS12-381 scalar field modulus; it has no caller-controlled inputs.
@pure
fun blsR(): int asm "BLS_PUSHR";

/// # Safety
/// Expects `z` to be a non-zero modulus; verifier callers pass `blsR()`.
@pure
fun mulmod(x: int, y: int, z: int): int asm "MULMOD";

/// # Safety
/// Expects both slices to contain canonically encoded BLS12-381 G1 points.
@pure
fun blsG1Add(a: slice, b: slice): slice asm "BLS_G1_ADD";

/// # Safety
/// Expects the slice to contain a canonically encoded BLS12-381 G1 point.
@pure
fun blsG1Mul(x: slice, s: int): slice asm "BLS_G1_MUL";

/// # Safety
/// Expects both slices to contain canonically encoded BLS12-381 G1 points.
@pure
fun blsG1Sub(a: slice, b: slice): slice asm "BLS_G1_SUB";

/// # Safety
/// Expects the slice to contain a canonically encoded BLS12-381 G1 point.
@pure
fun blsG1Neg(a: slice): slice asm "BLS_G1_NEG";

/// # Safety
/// Returns false for invalid or non-prime-order BLS12-381 G1 encodings.
@pure
fun blsG1InGroup(x: slice): bool asm "BLS_G1_INGROUP";

/// # Safety
/// Returns true only for the canonical BLS12-381 G1 identity encoding.
@pure
fun blsG1IsZero(x: slice): bool asm "BLS_G1_ISZERO";

fun normalizeMod(x: int, z: int): int {
  var res: int = x % z;
  if (res < 0) {
    res += z;
  }
  return res;
}

fun addmod(x: int, y: int, z: int): int {
  return normalizeMod(x + y, z);
}

fun G1Compressed.asSlice(self): slice {
  return self as slice;
}

/// Convert a scalar to the 32-byte big-endian slice used by the transcript.
fun int.scalarToSlice(self): slice {
  return beginCell().storeUint(self, 256).endCell().beginParse();
}

fun ffInverse(a: int, q: int): int {
  var t: int = 0;
  var newt: int = 1;
  var r: int = q;
  var newr: int = normalizeMod(a, q);
  var quotient: int = 0;
  var aux: int = 0;

  while (newr != 0) {
    quotient = r / newr;
    aux = t - quotient * newt;
    t = newt;
    newt = aux;

    aux = r - quotient * newr;
    r = newr;
    newr = aux;
  }

  if (r > 1) {
    throw <%= errFailedInverse %>;
  }

  if (t < 0) {
    t += q;
  }

  return t;
}

fun ScalarArray.read(self, i: int): int {
  if (i < 0 || i >= self.size()) {
    throw <%= errPublicNotPresent %>;
  }
  return self.get(i) as int;
}

fun ScalarArray.setAt(mutate self, i: int, v: int): void {
  while (self.size() <= i) {
    self.push(0 as uint256);
  }
  self.set(normalizeMod(v, blsR()) as uint256, i);
}

fun inverseArray(vals: ScalarArray, n: int): ScalarArray {
  var aux: ScalarArray = [];
  var acc: int = vals.read(0);
  var i: int = 1;

  while (i < n) {
    aux.setAt(i, acc);
    acc = mulmod(acc, vals.read(i), blsR());
    i += 1;
  }

  acc = ffInverse(acc, blsR());
  i -= 1;

  while (i > 0) {
    val inv = mulmod(acc, aux.read(i), blsR());
    acc = mulmod(acc, vals.read(i), blsR());
    vals.setAt(i, inv);
    i -= 1;
  }

  vals.setAt(0, acc);
  return vals;
}

fun checkField(x: int): void {
  if (x < 0 || x >= blsR()) {
    throw <%= errScalarNotInField %>;
  }
}

fun checkProofPoint(point: slice): void {
  if (point.remainingBitsCount() != 384 || point.remainingRefsCount() != 0) {
    throw <%= errInvalidProof %>;
  }
  if (!blsG1InGroup(point) || blsG1IsZero(point)) {
    throw <%= errInvalidProof %>;
  }
}

@inline
fun lessThanSixLimbs(
  mutate encoded: slice,
  limb5: int,
  limb4: int,
  limb3: int,
  limb2: int,
  limb1: int,
  limb0: int
): bool {
  val value5 = encoded.loadUint(64);
  val value4 = encoded.loadUint(64);
  val value3 = encoded.loadUint(64);
  val value2 = encoded.loadUint(64);
  val value1 = encoded.loadUint(64);
  val value0 = encoded.loadUint(64);
  encoded.assertEnd();
  if (value5 != limb5) { return value5 < limb5; }
  if (value4 != limb4) { return value4 < limb4; }
  if (value3 != limb3) { return value3 < limb3; }
  if (value2 != limb2) { return value2 < limb2; }
  if (value1 != limb1) { return value1 < limb1; }
  return value0 < limb0;
}

@inline
fun lessThanBaseField(encoded: slice): bool {
  return lessThanSixLimbs(
    mutate encoded,
    0x1a0111ea397fe69a, 0x4b1ba7b6434bacd7,
    0x64774b84f38512bf, 0x6730d2a0f6b0f624,
    0x1eabfffeb153ffff, 0xb9feffffffffaaab
  );
}

@inline
fun lessThanHalfBaseField(encoded: slice): bool {
  return lessThanSixLimbs(
    mutate encoded,
    0x0d0088f51cbff34d, 0x258dd3db21a5d66b,
    0xb23ba5c279c2895f, 0xb39869507b587b12,
    0x0f55ffff58a9ffff, 0xdcff7fffffffd556
  );
}

@inline
fun sameCompressedX(compressed: slice, x: slice): bool {
  var compressedReader = compressed;
  var xReader = x;
  val first = compressedReader.loadUint(64);
  var same = first % 2305843009213693952 == xReader.loadUint(64);
  var i: int = 0;
  while (i < 5) {
    if (compressedReader.loadUint(64) != xReader.loadUint(64)) {
      same = false;
    }
    i += 1;
  }
  compressedReader.assertEnd();
  xReader.assertEnd();
  return same;
}

@inline
fun sliceIsZero(mutate encoded: slice, n: int): bool {
  var aggregate: int = 0;
  var i: int = 0;
  while (i < n) {
    aggregate |= encoded.loadUint(64);
    i += 1;
  }
  encoded.assertEnd();
  return aggregate == 0;
}

@inline
fun addModSafe(a: int, b: int, modulus: int): int {
  if (a >= modulus - b) {
    return a - (modulus - b);
  }
  return a + b;
}

@inline
fun sliceResidue(mutate encoded: slice, n: int, modulus: int): int {
  var residue: int = 0;
  var i: int = 0;
  while (i < n) {
    residue = addModSafe(
      mulmod(residue, 340282366920938463463374607431768211456, modulus),
      encoded.loadUint(128),
      modulus
    );
    i += 1;
  }
  encoded.assertEnd();
  return residue;
}

@inline
fun checkEquationMod(
  x: slice,
  y: slice,
  quotient: slice,
  negative: bool,
  modulus: int,
  pModulus: int
): void {
  val xr = sliceResidue(mutate x, 3, modulus);
  val yr = sliceResidue(mutate y, 3, modulus);
  val qr = sliceResidue(mutate quotient, 6, modulus);
  val x3 = mulmod(mulmod(xr, xr, modulus), xr, modulus);
  val y2 = mulmod(yr, yr, modulus);
  val qp = mulmod(qr, pModulus, modulus);
  var lhs = addModSafe(x3, 4, modulus);
  if (negative) {
    lhs = addModSafe(lhs, qp, modulus);
    if (lhs != y2) {
      throw <%= errInvalidProof %>;
    }
  } else if (lhs != addModSafe(y2, qp, modulus)) {
    throw <%= errInvalidProof %>;
  }
}

@inline
fun sliceResidue128(mutate encoded: slice, n: int): int {
  val modulus = 340282366920938463463374607431768211455;
  var residue: int = 0;
  var i: int = 0;
  while (i < n) {
    var chunk = encoded.loadUint(128);
    if (chunk == modulus) {
      chunk = 0;
    }
    residue = addModSafe(residue, chunk, modulus);
    i += 1;
  }
  encoded.assertEnd();
  return residue;
}

@inline
fun checkEquationMod128(
  x: slice,
  y: slice,
  quotient: slice,
  negative: bool
): void {
  val modulus = 340282366920938463463374607431768211455;
  val xr = sliceResidue128(mutate x, 3);
  val yr = sliceResidue128(mutate y, 3);
  val qr = sliceResidue128(mutate quotient, 6);
  val x3 = mulmod(mulmod(xr, xr, modulus), xr, modulus);
  val y2 = mulmod(yr, yr, modulus);
  val qp = mulmod(qr, 208877612993915134671969646143013146022, modulus);
  var lhs = addModSafe(x3, 4, modulus);
  if (negative) {
    lhs = addModSafe(lhs, qp, modulus);
    if (lhs != y2) {
      throw <%= errInvalidProof %>;
    }
  } else if (lhs != addModSafe(y2, qp, modulus)) {
    throw <%= errInvalidProof %>;
  }
}

fun checkCurveEquation(
  x: slice,
  y: slice,
  quotient: slice,
  negative: bool
): void {
  // The five pairwise-coprime moduli have a 1150-bit product. With canonical
  // x,y < p and a 768-bit |q|, |x^3 + 4 - y^2 - q*p| is below 2^1150,
  // so equality modulo all five is equivalent to exact integer equality.
  checkEquationMod(
    x, y, quotient, negative,
    115792089237316195423570985008687907853269984665640564039457584007908834671663,
    45442060874369865957053122457214185817766951338729763812469558174980632365874
  );
  checkEquationMod(
    x, y, quotient, negative,
    115792089210356248762697446949407573530086143415290314195533631308867097853951,
    38110890092560713635066568006917044494578826803373145873585304601562188213582
  );
  checkEquationMod(
    x, y, quotient, negative,
    57896044618658097711785492504343953926634992332820282019728792003956564819949,
    45442060874369865957053122457065728163911979137268805490623197713172086346389
  );
  checkEquationMod(
    x, y, quotient, negative,
    52435875175126190479447740508185965837690552500527637822603658699938581184513,
    52435875175126190479447740508185965837690552500527637822588526323715639541761
  );
  checkEquationMod128(x, y, quotient, negative);
}

/// Validates that TVM compressed bytes and snarkjs transcript coordinates
/// encode the same canonical, non-identity prime-order G1 point.
fun checkPointBinding(compressed: slice, transcriptPoint: slice): slice {
  if (
    transcriptPoint.remainingBitsCount() != 768 ||
    transcriptPoint.remainingRefsCount() != 1
  ) {
    throw <%= errInvalidProof %>;
  }

  var transcript = transcriptPoint;
  val coordinates = transcript.loadBits(768);
  var witness = transcript.loadRef().beginParse();
  transcript.assertEnd();
  if (witness.remainingBitsCount() != 769 || witness.remainingRefsCount() != 0) {
    throw <%= errInvalidProof %>;
  }
  val negative = witness.loadBool();
  val quotient = witness.loadBits(768);
  witness.assertEnd();
  var quotientZeroReader = quotient;
  if (negative && sliceIsZero(mutate quotientZeroReader, 12)) {
    throw <%= errInvalidProof %>;
  }

  var coordinateReader = coordinates;
  val xEncoded = coordinateReader.loadBits(384);
  val yEncoded = coordinateReader.loadBits(384);
  coordinateReader.assertEnd();
  if (!lessThanBaseField(xEncoded) || !lessThanBaseField(yEncoded)) {
    throw <%= errInvalidProof %>;
  }

  if (compressed.remainingBitsCount() != 384 || compressed.remainingRefsCount() != 0) {
    throw <%= errInvalidProof %>;
  }
  var compressedReader = compressed;
  val first = compressedReader.loadUint(64);
  val topByte = first / 72057594037927936;
  val flags = (topByte / 32) * 32;
  if (flags != 0x80 && flags != 0xa0) {
    throw <%= errInvalidProof %>;
  }
  if (!sameCompressedX(compressed, xEncoded)) {
    throw <%= errInvalidProof %>;
  }
  val upperY = !lessThanHalfBaseField(yEncoded);
  if ((flags == 0xa0) != upperY) {
    throw <%= errInvalidProof %>;
  }

  checkCurveEquation(xEncoded, yEncoded, quotient, negative);

  return coordinates;
}

fun checkPublicInputCount(publicInputs: ScalarArray, nExpected: int): void {
  val count = publicInputs.size();
  if (count > nExpected) {
    throw <%= errTooManyPublics %>;
  }

  if (count != nExpected) {
    throw <%= errPublicNotPresent %>;
  }
}

fun requireMessageShape(value: slice, bits: int, refs: int): void {
  if (
    value.remainingBitsCount() != bits ||
    value.remainingRefsCount() != refs
  ) {
    throw <%= errInvalidMessage %>;
  }
}

fun validateTranscriptCell(value: cell): void {
  var reader = value.beginParse();
  requireMessageShape(reader, 768, 1);
  val _coordinates = reader.loadBits(768);
  val witness = reader.loadRef().beginParse();
  reader.assertEnd();
  requireMessageShape(witness, 769, 0);
}

fun validatePublicInputEncoding(mutate payload: slice): void {
  val length = payload.loadUint(8);
  val hasFirst = payload.loadBool();
  if (length != N_PUBLIC || hasFirst != (N_PUBLIC > 0)) {
    throw <%= errInvalidMessage %>;
  }
  if (N_PUBLIC == 0) {
    return;
  }

  var chunk = payload.loadRef().beginParse();
  var remaining = N_PUBLIC;
  while (remaining > 0) {
    val count = remaining > 3 ? 3 : remaining;
    val hasNext = remaining > 3;
    requireMessageShape(chunk, 1 + count * 256, hasNext ? 1 : 0);
    if (chunk.loadBool() != hasNext) {
      throw <%= errInvalidMessage %>;
    }
    val _values = chunk.loadBits(count * 256);
    remaining -= count;
    if (hasNext) {
      chunk = chunk.loadRef().beginParse();
    } else {
      chunk.assertEnd();
    }
  }
}

fun validateProofMessageShape(body: slice): void {
  var message = body;
  requireMessageShape(message, 32, 1);
  if (message.loadUint(32) != 0x76524659) {
    throw <%= errInvalidMessage %>;
  }
  var payload = message.loadRef().beginParse();
  message.assertEnd();
  requireMessageShape(payload, 9, <%= publicCount === 0 ? 3 : 4 %>);

  var compressed = payload.loadRef().beginParse();
  var evaluations = payload.loadRef().beginParse();
  validatePublicInputEncoding(mutate payload);
  var uncompressed = payload.loadRef().beginParse();
  payload.assertEnd();

  requireMessageShape(compressed, 0, 4);
  val ab = compressed.loadRef().beginParse();
  val cz = compressed.loadRef().beginParse();
  val t12 = compressed.loadRef().beginParse();
  var compressedTail = compressed.loadRef().beginParse();
  compressed.assertEnd();
  requireMessageShape(ab, 768, 0);
  requireMessageShape(cz, 768, 0);
  requireMessageShape(t12, 768, 0);
  requireMessageShape(compressedTail, 0, 2);
  val t3Wxi = compressedTail.loadRef().beginParse();
  val wxiw = compressedTail.loadRef().beginParse();
  compressedTail.assertEnd();
  requireMessageShape(t3Wxi, 768, 0);
  requireMessageShape(wxiw, 384, 0);

  requireMessageShape(evaluations, 0, 2);
  val abc = evaluations.loadRef().beginParse();
  val rest = evaluations.loadRef().beginParse();
  evaluations.assertEnd();
  requireMessageShape(abc, 768, 0);
  requireMessageShape(rest, 768, 0);

  requireMessageShape(uncompressed, 0, 4);
  val a = uncompressed.loadRef();
  val b = uncompressed.loadRef();
  val c = uncompressed.loadRef();
  var uncompressedTail = uncompressed.loadRef().beginParse();
  uncompressed.assertEnd();
  validateTranscriptCell(a);
  validateTranscriptCell(b);
  validateTranscriptCell(c);
  requireMessageShape(uncompressedTail, 0, 4);
  val z = uncompressedTail.loadRef();
  val t1 = uncompressedTail.loadRef();
  val t2 = uncompressedTail.loadRef();
  var uncompressedTail2 = uncompressedTail.loadRef().beginParse();
  uncompressedTail.assertEnd();
  validateTranscriptCell(z);
  validateTranscriptCell(t1);
  validateTranscriptCell(t2);
  requireMessageShape(uncompressedTail2, 0, 3);
  val t3 = uncompressedTail2.loadRef();
  val wxi = uncompressedTail2.loadRef();
  val wxiwTranscript = uncompressedTail2.loadRef();
  uncompressedTail2.assertEnd();
  validateTranscriptCell(t3);
  validateTranscriptCell(wxi);
  validateTranscriptCell(wxiwTranscript);
}

fun verifyFromPayload(payload: VerifyProofPayload): bool {
  val compressed = payload.compressed.load();
  val ab = compressed.ab.load();
  val cz = compressed.cz.load();
  val t12 = compressed.t12.load();
  val compressedTail = compressed.tail.load();
  val t3Wxi = compressedTail.t3Wxi.load();

  val evaluations = payload.evaluations.load();
  val abc = evaluations.abc.load();
  val rest = evaluations.rest.load();

  val uncompressed = payload.uncompressed.load();
  val uncompressedTail = uncompressed.tail.load();
  val uncompressedTail2 = uncompressedTail.tail.load();

  return verify(
    ab.first.asSlice(), ab.second.asSlice(), cz.first.asSlice(), cz.second.asSlice(),
    t12.first.asSlice(), t12.second.asSlice(), t3Wxi.first.asSlice(),
    abc.evalA as int, abc.evalB as int, abc.evalC as int,
    rest.evalS1 as int, rest.evalS2 as int, rest.evalZw as int,
    t3Wxi.second.asSlice(), compressedTail.wxiw.load().asSlice(),
    payload.publicInputs,
    uncompressed.a.beginParse(), uncompressed.b.beginParse(), uncompressed.c.beginParse(),
    uncompressedTail.z.beginParse(), uncompressedTail.t1.beginParse(), uncompressedTail.t2.beginParse(),
    uncompressedTail2.t3.beginParse(), uncompressedTail2.wxi.beginParse(), uncompressedTail2.wxiw.beginParse()
  );
}

fun onInternalMessage(inMsg: InMessage) {
  if (!inMsg.body.isEmpty()) {
    assert (inMsg.valueCoins >= MIN_VERIFY_VALUE) throw <%= errNotEnoughValue %>;
    validateProofMessageShape(inMsg.body);
    val msg = VerifyProofMessage.fromSlice(inMsg.body, { throwIfOpcodeDoesNotMatch: <%= errInvalidMessage %> });
    assert (verifyFromPayload(msg.proof.load())) throw <%= errInvalidProof %>;
  }
}

/// Verifies a snarkjs-compatible PLONK proof.
get fun verify(
  a: slice, b: slice, c: slice, z: slice, t1: slice, t2: slice, t3: slice,
  evalA: int, evalB: int, evalC: int, evalS1: int, evalS2: int, evalZw: int,
  wxi: slice, wxiw: slice,
  publicInputs: ScalarArray,
  aUc: slice, bUc: slice, cUc: slice, zUc: slice,
  t1Uc: slice, t2Uc: slice, t3Uc: slice,
  wxiUc: slice, wxiwUc: slice
): bool {
  checkProofPoint(a);
  checkProofPoint(b);
  checkProofPoint(c);
  checkProofPoint(z);
  checkProofPoint(t1);
  checkProofPoint(t2);
  checkProofPoint(t3);
  checkProofPoint(wxi);
  checkProofPoint(wxiw);

  val aTranscript = checkPointBinding(a, aUc);
  val bTranscript = checkPointBinding(b, bUc);
  val cTranscript = checkPointBinding(c, cUc);
  val zTranscript = checkPointBinding(z, zUc);
  val t1Transcript = checkPointBinding(t1, t1Uc);
  val t2Transcript = checkPointBinding(t2, t2Uc);
  val t3Transcript = checkPointBinding(t3, t3Uc);
  val wxiTranscript = checkPointBinding(wxi, wxiUc);
  val wxiwTranscript = checkPointBinding(wxiw, wxiwUc);

  checkField(evalA);
  checkField(evalB);
  checkField(evalC);
  checkField(evalS1);
  checkField(evalS2);
  checkField(evalZw);

  // Challenge round 2: beta.
  var betaHash: array<slice> = [];
  betaHash.push(QM_UC);
  betaHash.push(QL_UC);
  betaHash.push(QR_UC);
  betaHash.push(QO_UC);
  betaHash.push(QC_UC);
  betaHash.push(S1_UC);
  betaHash.push(S2_UC);
  betaHash.push(S3_UC);

  var pi: int = 0;
  while (pi < N_PUBLIC) {
    val publicInput = publicInputs.read(pi);
    checkField(publicInput);
    betaHash.push(publicInput.scalarToSlice());
    pi += 1;
  }
  checkPublicInputCount(publicInputs, N_PUBLIC);

  betaHash.push(aTranscript);
  betaHash.push(bTranscript);
  betaHash.push(cTranscript);

  val beta = keccak256Tuple(betaHash) % blsR();

  // Challenge: gamma.
  var gammaHash: array<slice> = [];
  gammaHash.push(beta.scalarToSlice());
  val gamma = keccak256Tuple(gammaHash) % blsR();

  // Challenge round 3: alpha.
  var alphaHash: array<slice> = [];
  alphaHash.push(beta.scalarToSlice());
  alphaHash.push(gamma.scalarToSlice());
  alphaHash.push(zTranscript);
  val alpha = keccak256Tuple(alphaHash) % blsR();

  val alpha2 = mulmod(alpha, alpha, blsR());

  // Challenge round 4: xi.
  var xiHash: array<slice> = [];
  xiHash.push(alpha.scalarToSlice());
  xiHash.push(t1Transcript);
  xiHash.push(t2Transcript);
  xiHash.push(t3Transcript);
  val xi = keccak256Tuple(xiHash) % blsR();

  val betaXi = mulmod(beta, xi, blsR());
  var xin: int = xi;

<% if (xinSquares) { -%>
<%- xinSquares %>
<% } -%>

  val zh = normalizeMod(xin - 1, blsR());
  var invs: ScalarArray = [];
  invs.setAt(0, zh);

  // Challenge round 5: v.
  var vHash: array<slice> = [];
  vHash.push(xi.scalarToSlice());
  vHash.push(evalA.scalarToSlice());
  vHash.push(evalB.scalarToSlice());
  vHash.push(evalC.scalarToSlice());
  vHash.push(evalS1.scalarToSlice());
  vHash.push(evalS2.scalarToSlice());
  vHash.push(evalZw.scalarToSlice());

  val v1 = keccak256Tuple(vHash) % blsR();
  val v2 = mulmod(v1, v1, blsR());
  val v3 = mulmod(v2, v1, blsR());
  val v4 = mulmod(v3, v1, blsR());
  val v5 = mulmod(v4, v1, blsR());

  // Challenge: u.
  var uHash: array<slice> = [];
  uHash.push(wxiTranscript);
  uHash.push(wxiwTranscript);
  val u = keccak256Tuple(uHash) % blsR();

  // Lagrange evaluations.
  var w: int = 1;

<%- inverseSeedLines %>

  val invd = inverseArray(invs, N_LAGRANGE + 1);
  var restEvals: ScalarArray = [];

  w = 1;

<%- lagrangeEvalLines %>

  // PI (public input polynomial evaluation).
  var pl: int = 0;

<% if (publicInputEvalLines) { -%>
<%- publicInputEvalLines %>
<% } -%>

  // Compute linearization polynomial commitment.
  val e1 = pl;
  val e2 = mulmod(evalL1, alpha2, blsR());

  var e3a = addmod(evalA, mulmod(beta, evalS1, blsR()), blsR());
  e3a = addmod(e3a, gamma, blsR());

  var e3b = addmod(evalB, mulmod(beta, evalS2, blsR()), blsR());
  e3b = addmod(e3b, gamma, blsR());

  val e3c = addmod(evalC, gamma, blsR());

  var e3 = mulmod(mulmod(e3a, e3b, blsR()), e3c, blsR());
  e3 = mulmod(e3, evalZw, blsR());
  e3 = mulmod(e3, alpha, blsR());

  var r0 = addmod(e1, (-e2) % blsR(), blsR());
  r0 = addmod(r0, (-e3) % blsR(), blsR());

  // D polynomial commitment.
  var d1 = blsG1Mul(QM, mulmod(evalA, evalB, blsR()));
  d1 = blsG1Add(d1, blsG1Mul(QL, evalA));
  d1 = blsG1Add(d1, blsG1Mul(QR, evalB));
  d1 = blsG1Add(d1, blsG1Mul(QO, evalC));
  d1 = blsG1Add(d1, QC);

  val d2a1 = addmod(addmod(evalA, betaXi, blsR()), gamma, blsR());
  val d2a2 = addmod(addmod(evalB, mulmod(betaXi, K1, blsR()), blsR()), gamma, blsR());
  val d2a3 = addmod(addmod(evalC, mulmod(betaXi, K2, blsR()), blsR()), gamma, blsR());

  var d2a = mulmod(d2a1, d2a2, blsR());
  d2a = mulmod(d2a, d2a3, blsR());
  d2a = mulmod(d2a, alpha, blsR());

  val d2b = mulmod(evalL1, alpha2, blsR());
  val d2 = blsG1Mul(z, addmod(addmod(d2a, d2b, blsR()), u, blsR()));

  val d3a = addmod(addmod(evalA, mulmod(beta, evalS1, blsR()), blsR()), gamma, blsR());
  val d3b = addmod(addmod(evalB, mulmod(beta, evalS2, blsR()), blsR()), gamma, blsR());
  val d3c = mulmod(mulmod(alpha, beta, blsR()), evalZw, blsR());

  val d3 = blsG1Mul(S3, mulmod(mulmod(d3a, d3b, blsR()), d3c, blsR()));

  val d4low = t1;
  val d4mid = blsG1Mul(t2, xin);
  val d4high = blsG1Mul(t3, mulmod(xin, xin, blsR()));
  var d4 = blsG1Add(d4low, blsG1Add(d4mid, d4high));
  d4 = blsG1Mul(d4, zh);

  val d = blsG1Sub(blsG1Sub(blsG1Add(d1, d2), d3), d4);

  // F polynomial commitment.
  var f = blsG1Add(d, blsG1Mul(a, v1));
  f = blsG1Add(f, blsG1Mul(b, v2));
  f = blsG1Add(f, blsG1Mul(c, v3));
  f = blsG1Add(f, blsG1Mul(S1, v4));
  f = blsG1Add(f, blsG1Mul(S2, v5));

  // E polynomial commitment.
  var e = addmod((-r0) % blsR(), mulmod(v1, evalA, blsR()), blsR());
  e = addmod(e, mulmod(v2, evalB, blsR()), blsR());
  e = addmod(e, mulmod(v3, evalC, blsR()), blsR());
  e = addmod(e, mulmod(v4, evalS1, blsR()), blsR());
  e = addmod(e, mulmod(v5, evalS2, blsR()), blsR());
  e = addmod(e, mulmod(u, evalZw, blsR()), blsR());

  val eCommitment = blsG1Mul(BLS_G1, e);

  // Final pairing check.
  var a1 = wxi;
  a1 = blsG1Add(a1, blsG1Mul(wxiw, u));

  var b1 = blsG1Mul(wxi, xi);
  val s = mulmod(mulmod(u, xi, blsR()), W1, blsR());
  b1 = blsG1Add(b1, blsG1Mul(wxiw, s));
  b1 = blsG1Add(b1, f);
  b1 = blsG1Sub(b1, eCommitment);

  return blsPairing(blsG1Neg(a1), X_2, b1, BLS_G2) != 0;
}
