;; Convert scalar to slice for Keccak256 transcript (Big-Endian, 32 bytes)
slice verifier::scalar_to_slice(int x) inline {
    return begin_cell().store_uint(x, 256).end_cell().begin_parse();
}

int verifier::ff_inverse(int a, int q) inline {
    int t = 0;
    int newt = 1;
    int r = q;
    int newr = a;
    int quotient = 0;
    int aux = 0;
    while (newr) {
        quotient = r / newr;
        aux = t - quotient * newt;
        t = newt;
        newt = aux;

        aux = r - quotient * newr;
        r = newr;
        newr = aux;
    }

    if (r > 1) {
        throw(verifier::err::failed_inverse);
    }

    if (t < 0) {
        t += q;
    }

    return t;
}

int verifier::read_arr(cell arr, int i) inline {
    (slice v, int ok) = arr.udict_get?(verifier::publicInputKeyLen, i);
    throw_unless(verifier::err::public_not_present, ok);
    int value = v~load_uint(256);
    throw_unless(verifier::err::scalar_not_in_field, v.slice_empty?());
    return value;
}

(cell, ()) verifier::set_arr(cell arr, int i, int v) inline {
    arr~udict_set_builder(verifier::publicInputKeyLen, i, begin_cell().store_uint(v, 256));
    return (arr, ());
}

cell verifier::inverse_array(cell vals, int n) inline {
    cell aux = null();
    int acc = vals.verifier::read_arr(0);
    int i = 1;
    while (i < n) {
        aux~verifier::set_arr(i, acc);
        acc = mulmod(acc, vals.verifier::read_arr(i), bls::R());
        i += 1;
    }
    acc = verifier::ff_inverse(acc, bls::R());
    i -= 1;
    int inv = 0;
    while (i > 0) {
        inv = mulmod(acc, aux.verifier::read_arr(i), bls::R());
        acc = mulmod(acc, vals.verifier::read_arr(i), bls::R());
        vals~verifier::set_arr(i, inv);
        i -= 1;
    }
    vals~verifier::set_arr(0, acc);
    return vals;
}

;; this function should add similarly to mulmod (i.e. work well when x+y overflows but (x+y)%z doesn't)
;; but since here it's only used for 255 bit numbers no overflow should happen anyway
;; however pay attention when porting to other curves if that ever happens
int addmod(int x, int y, int z) inline {
    return (x + y) % z;
}

() verifier::check_field(int x) impure inline {
    throw_unless(verifier::err::scalar_not_in_field, x >= 0);
    throw_unless(verifier::err::scalar_not_in_field, x < bls::R());
}

() verifier::check_proof_point(slice point) impure inline {
    throw_unless(verifier::err::invalid_proof, slice_bits(point) == 384);
    throw_unless(verifier::err::invalid_proof, slice_refs(point) == 0);
    throw_unless(verifier::err::invalid_proof, bls::g1_in_group(point));
    throw_if(verifier::err::invalid_proof, bls::g1_is_zero(point));
}

int verifier::less_than_six_limbs(
    slice encoded,
    int limb5, int limb4, int limb3, int limb2, int limb1, int limb0
) inline {
    int decided = 0;
    int result = 0;
    int value = encoded~load_uint(64);
    if ((~ decided) & (value != limb5)) {
        result = value < limb5;
        decided = -1;
    }
    value = encoded~load_uint(64);
    if ((~ decided) & (value != limb4)) {
        result = value < limb4;
        decided = -1;
    }
    value = encoded~load_uint(64);
    if ((~ decided) & (value != limb3)) {
        result = value < limb3;
        decided = -1;
    }
    value = encoded~load_uint(64);
    if ((~ decided) & (value != limb2)) {
        result = value < limb2;
        decided = -1;
    }
    value = encoded~load_uint(64);
    if ((~ decided) & (value != limb1)) {
        result = value < limb1;
        decided = -1;
    }
    value = encoded~load_uint(64);
    if ((~ decided) & (value != limb0)) {
        result = value < limb0;
        decided = -1;
    }
    throw_unless(verifier::err::invalid_proof, encoded.slice_empty?());
    return result;
}

int verifier::less_than_base_field(slice encoded) inline {
    return verifier::less_than_six_limbs(
        encoded,
        0x1a0111ea397fe69a, 0x4b1ba7b6434bacd7,
        0x64774b84f38512bf, 0x6730d2a0f6b0f624,
        0x1eabfffeb153ffff, 0xb9feffffffffaaab
    );
}

int verifier::less_than_half_base_field(slice encoded) inline {
    return verifier::less_than_six_limbs(
        encoded,
        0x0d0088f51cbff34d, 0x258dd3db21a5d66b,
        0xb23ba5c279c2895f, 0xb39869507b587b12,
        0x0f55ffff58a9ffff, 0xdcff7fffffffd556
    );
}

int verifier::same_compressed_x(slice compressed, slice x) inline {
    int first = compressed~load_uint(64);
    int same = (first % 2305843009213693952) == x~load_uint(64);
    int i = 0;
    while (i < 5) {
        if (compressed~load_uint(64) != x~load_uint(64)) {
            same = 0;
        }
        i += 1;
    }
    throw_unless(verifier::err::invalid_proof, compressed.slice_empty?());
    throw_unless(verifier::err::invalid_proof, x.slice_empty?());
    return same;
}

int verifier::slice_is_zero(slice encoded, int n) inline {
    int aggregate = 0;
    int i = 0;
    while (i < n) {
        aggregate |= encoded~load_uint(64);
        i += 1;
    }
    throw_unless(verifier::err::invalid_proof, encoded.slice_empty?());
    return aggregate == 0;
}

int verifier::add_mod(int a, int b, int modulus) inline {
    if (a >= modulus - b) {
        return a - (modulus - b);
    }
    return a + b;
}

int verifier::slice_residue(slice encoded, int n, int modulus) inline {
    int residue = 0;
    int i = 0;
    while (i < n) {
        residue = verifier::add_mod(
            mulmod(residue, 340282366920938463463374607431768211456, modulus),
            encoded~load_uint(128),
            modulus
        );
        i += 1;
    }
    throw_unless(verifier::err::invalid_proof, encoded.slice_empty?());
    return residue;
}

() verifier::check_equation_mod(
    slice x, slice y, slice quotient, int negative, int modulus, int p_modulus
) impure inline {
    int xr = verifier::slice_residue(x, 3, modulus);
    int yr = verifier::slice_residue(y, 3, modulus);
    int qr = verifier::slice_residue(quotient, 6, modulus);
    int x3 = mulmod(mulmod(xr, xr, modulus), xr, modulus);
    int y2 = mulmod(yr, yr, modulus);
    int qp = mulmod(qr, p_modulus, modulus);
    int lhs = verifier::add_mod(x3, 4, modulus);
    if (negative) {
        lhs = verifier::add_mod(lhs, qp, modulus);
        throw_unless(verifier::err::invalid_proof, lhs == y2);
    } else {
        throw_unless(
            verifier::err::invalid_proof,
            lhs == verifier::add_mod(y2, qp, modulus)
        );
    }
}

int verifier::slice_residue_128(slice encoded, int n) inline {
    int modulus = 340282366920938463463374607431768211455;
    int residue = 0;
    int i = 0;
    while (i < n) {
        int chunk = encoded~load_uint(128);
        if (chunk == modulus) {
            chunk = 0;
        }
        residue = verifier::add_mod(residue, chunk, modulus);
        i += 1;
    }
    throw_unless(verifier::err::invalid_proof, encoded.slice_empty?());
    return residue;
}

() verifier::check_equation_mod_128(
    slice x, slice y, slice quotient, int negative
) impure inline {
    int modulus = 340282366920938463463374607431768211455;
    int xr = verifier::slice_residue_128(x, 3);
    int yr = verifier::slice_residue_128(y, 3);
    int qr = verifier::slice_residue_128(quotient, 6);
    int x3 = mulmod(mulmod(xr, xr, modulus), xr, modulus);
    int y2 = mulmod(yr, yr, modulus);
    int qp = mulmod(qr, 208877612993915134671969646143013146022, modulus);
    int lhs = verifier::add_mod(x3, 4, modulus);
    if (negative) {
        lhs = verifier::add_mod(lhs, qp, modulus);
        throw_unless(verifier::err::invalid_proof, lhs == y2);
    } else {
        throw_unless(
            verifier::err::invalid_proof,
            lhs == verifier::add_mod(y2, qp, modulus)
        );
    }
}

() verifier::check_curve_equation(
    slice x, slice y, slice quotient, int negative
) impure {
    ;; The five pairwise-coprime moduli have a 1150-bit product. With canonical
    ;; x,y < p and a 768-bit |q|, |x^3 + 4 - y^2 - q*p| is below 2^1150,
    ;; so equality modulo all five is equivalent to exact integer equality.
    verifier::check_equation_mod(
        x, y, quotient, negative,
        115792089237316195423570985008687907853269984665640564039457584007908834671663,
        45442060874369865957053122457214185817766951338729763812469558174980632365874
    );
    verifier::check_equation_mod(
        x, y, quotient, negative,
        115792089210356248762697446949407573530086143415290314195533631308867097853951,
        38110890092560713635066568006917044494578826803373145873585304601562188213582
    );
    verifier::check_equation_mod(
        x, y, quotient, negative,
        57896044618658097711785492504343953926634992332820282019728792003956564819949,
        45442060874369865957053122457065728163911979137268805490623197713172086346389
    );
    verifier::check_equation_mod(
        x, y, quotient, negative,
        52435875175126190479447740508185965837690552500527637822603658699938581184513,
        52435875175126190479447740508185965837690552500527637822588526323715639541761
    );
    verifier::check_equation_mod_128(x, y, quotient, negative);
}

;; Proves that the TVM compressed point and the snarkjs transcript coordinates
;; describe the same canonical BLS12-381 G1 point.
slice verifier::check_point_binding(slice compressed, slice transcript_point) impure {
    throw_unless(verifier::err::invalid_proof, slice_bits(transcript_point) == 768);
    throw_unless(verifier::err::invalid_proof, slice_refs(transcript_point) == 1);
    slice coordinates = transcript_point~load_bits(768);
    slice witness = transcript_point~load_ref().begin_parse();
    throw_unless(verifier::err::invalid_proof, transcript_point.slice_empty?());
    throw_unless(verifier::err::invalid_proof, slice_bits(witness) == 769);
    throw_unless(verifier::err::invalid_proof, slice_refs(witness) == 0);
    int negative = witness~load_uint(1);
    slice quotient = witness~load_bits(768);
    throw_unless(verifier::err::invalid_proof, witness.slice_empty?());
    throw_if(
        verifier::err::invalid_proof,
        negative & verifier::slice_is_zero(quotient, 12)
    );

    slice coordinate_reader = coordinates;
    slice x_encoded = coordinate_reader~load_bits(384);
    slice y_encoded = coordinate_reader~load_bits(384);
    throw_unless(verifier::err::invalid_proof, coordinate_reader.slice_empty?());
    throw_unless(
        verifier::err::invalid_proof,
        verifier::less_than_base_field(x_encoded)
    );
    throw_unless(
        verifier::err::invalid_proof,
        verifier::less_than_base_field(y_encoded)
    );

    slice compressed_reader = compressed;
    int first = compressed_reader~load_uint(64);
    int top_byte = first / 72057594037927936;
    int flags = (top_byte / 32) * 32;
    throw_unless(verifier::err::invalid_proof, (flags == 0x80) | (flags == 0xa0));
    throw_unless(
        verifier::err::invalid_proof,
        verifier::same_compressed_x(compressed, x_encoded)
    );
    int upper_y = ~ verifier::less_than_half_base_field(y_encoded);
    throw_unless(verifier::err::invalid_proof, (flags == 0xa0) == upper_y);

    verifier::check_curve_equation(x_encoded, y_encoded, quotient, negative);
    return coordinates;
}

() verifier::validate_transcript_message(slice point) impure inline {
    throw_unless(verifier::err::invalid_message, slice_bits(point) == 768);
    throw_unless(verifier::err::invalid_message, slice_refs(point) == 1);
    point~load_bits(768);
    slice witness = point~load_ref().begin_parse();
    throw_unless(verifier::err::invalid_message, point.slice_empty?());
    throw_unless(verifier::err::invalid_message, slice_bits(witness) == 769);
    throw_unless(verifier::err::invalid_message, slice_refs(witness) == 0);
}

() verifier::validate_public_message(cell public) impure {
<% if (nPublic === 0) { -%>
    slice empty_public = public.begin_parse();
    throw_unless(verifier::err::invalid_message, empty_public.slice_empty?());
<% } else { -%>
    cell public_tmp = public;
    int pi = 0;
    try {
        while (pi < verifier::nPublic) {
            (slice value, int ok) = public_tmp~udict_delete_get?(
                verifier::publicInputKeyLen,
                pi
            );
            throw_unless(verifier::err::invalid_message, ok);
            throw_unless(verifier::err::invalid_message, slice_bits(value) == 256);
            throw_unless(verifier::err::invalid_message, slice_refs(value) == 0);
            pi += 1;
        }
        throw_unless(verifier::err::invalid_message, null?(public_tmp));
    } catch (_, int error_code) {
        throw(verifier::err::invalid_message);
    }
<% } -%>
}

;; Main verify function
;; Compressed points (A, B, C, Z, T1, T2, T3, Wxi, Wxiw) - for BLS operations
;; Uncompressed points (A_uc, B_uc, C_uc, Z_uc, T1_uc, T2_uc, T3_uc, Wxi_uc, Wxiw_uc) - for Keccak256 transcript
int verify(
    slice A, slice B, slice C, slice Z, slice T1, slice T2, slice T3,
    int eval_a, int eval_b, int eval_c, int eval_s1, int eval_s2, int eval_zw,
    slice Wxi, slice Wxiw,
    cell public,
    slice A_uc, slice B_uc, slice C_uc, slice Z_uc,
    slice T1_uc, slice T2_uc, slice T3_uc,
    slice Wxi_uc, slice Wxiw_uc
) method_id {
    verifier::check_proof_point(A);
    verifier::check_proof_point(B);
    verifier::check_proof_point(C);
    verifier::check_proof_point(Z);
    verifier::check_proof_point(T1);
    verifier::check_proof_point(T2);
    verifier::check_proof_point(T3);
    verifier::check_proof_point(Wxi);
    verifier::check_proof_point(Wxiw);

    A_uc = verifier::check_point_binding(A, A_uc);
    B_uc = verifier::check_point_binding(B, B_uc);
    C_uc = verifier::check_point_binding(C, C_uc);
    Z_uc = verifier::check_point_binding(Z, Z_uc);
    T1_uc = verifier::check_point_binding(T1, T1_uc);
    T2_uc = verifier::check_point_binding(T2, T2_uc);
    T3_uc = verifier::check_point_binding(T3, T3_uc);
    Wxi_uc = verifier::check_point_binding(Wxi, Wxi_uc);
    Wxiw_uc = verifier::check_point_binding(Wxiw, Wxiw_uc);

    verifier::check_field(eval_a);
    verifier::check_field(eval_b);
    verifier::check_field(eval_c);
    verifier::check_field(eval_s1);
    verifier::check_field(eval_s2);
    verifier::check_field(eval_zw);

    ;; ============================================
    ;; Challenge computation using Keccak256 transcript
    ;; Compatible with snarkjs PLONK
    ;; ============================================

    ;; Challenge round 2: beta
    ;; Hash: Qm_uc || Ql_uc || Qr_uc || Qo_uc || Qc_uc || S1_uc || S2_uc || S3_uc || publicSignals || A_uc || B_uc || C_uc
    tuple beta_hash = empty_tuple();
    beta_hash~tpush(verifier::Qm_uc);
    beta_hash~tpush(verifier::Ql_uc);
    beta_hash~tpush(verifier::Qr_uc);
    beta_hash~tpush(verifier::Qo_uc);
    beta_hash~tpush(verifier::Qc_uc);
    beta_hash~tpush(verifier::S1_uc);
    beta_hash~tpush(verifier::S2_uc);
    beta_hash~tpush(verifier::S3_uc);

    ;; Add public signals (as 32-byte big-endian scalars)
    int pi = 0;
<% if (nPublic === 0) { -%>
    throw_unless(verifier::err::too_many_publics, public.begin_parse().slice_empty?());
<% } else { -%>
    cell public_tmp = public;
    while (pi < verifier::nPublic) {
        (slice v, int ok) = public_tmp~udict_delete_get?(verifier::publicInputKeyLen, pi);
        throw_unless(verifier::err::public_not_present, ok);
        int public_input = v~load_uint(256);
        throw_unless(verifier::err::scalar_not_in_field, v.slice_empty?());
        verifier::check_field(public_input);
        pi += 1;
        beta_hash~tpush(verifier::scalar_to_slice(public_input));
    }
    throw_unless(verifier::err::too_many_publics, null?(public_tmp));
<% } -%>

    beta_hash~tpush(A_uc);
    beta_hash~tpush(B_uc);
    beta_hash~tpush(C_uc);

    int beta = beta_hash.keccak256_tuple() % bls::R();

    ;; Challenge: gamma
    ;; Hash: beta
    tuple gamma_hash = empty_tuple();
    gamma_hash~tpush(beta.verifier::scalar_to_slice());
    int gamma = gamma_hash.keccak256_tuple() % bls::R();

    ;; Challenge round 3: alpha
    ;; Hash: beta || gamma || Z_uc
    tuple alpha_hash = empty_tuple();
    alpha_hash~tpush(beta.verifier::scalar_to_slice());
    alpha_hash~tpush(gamma.verifier::scalar_to_slice());
    alpha_hash~tpush(Z_uc);
    int alpha = alpha_hash.keccak256_tuple() % bls::R();

    int alpha2 = mulmod(alpha, alpha, bls::R());

    ;; Challenge round 4: xi
    ;; Hash: alpha || T1_uc || T2_uc || T3_uc
    tuple xi_hash = empty_tuple();
    xi_hash~tpush(alpha.verifier::scalar_to_slice());
    xi_hash~tpush(T1_uc);
    xi_hash~tpush(T2_uc);
    xi_hash~tpush(T3_uc);
    int xi = xi_hash.keccak256_tuple() % bls::R();

    int betaXi = mulmod(beta, xi, bls::R());

    int xin = xi;

<% if (xinSquares) { -%>
<%- xinSquares %>
<% } -%>

    int zh = (xin - 1) % bls::R();
    cell invs = null();
    invs~verifier::set_arr(0, zh);

    ;; Challenge round 5: v
    ;; Hash: xi || eval_a || eval_b || eval_c || eval_s1 || eval_s2 || eval_zw
    tuple v_hash = empty_tuple();
    v_hash~tpush(xi.verifier::scalar_to_slice());
    v_hash~tpush(eval_a.verifier::scalar_to_slice());
    v_hash~tpush(eval_b.verifier::scalar_to_slice());
    v_hash~tpush(eval_c.verifier::scalar_to_slice());
    v_hash~tpush(eval_s1.verifier::scalar_to_slice());
    v_hash~tpush(eval_s2.verifier::scalar_to_slice());
    v_hash~tpush(eval_zw.verifier::scalar_to_slice());

    int v1 = v_hash.keccak256_tuple() % bls::R();
    int v2 = mulmod(v1, v1, bls::R());
    int v3 = mulmod(v2, v1, bls::R());
    int v4 = mulmod(v3, v1, bls::R());
    int v5 = mulmod(v4, v1, bls::R());

    ;; Challenge: u
    ;; Hash: Wxi_uc || Wxiw_uc
    tuple u_hash = empty_tuple();
    u_hash~tpush(Wxi_uc);
    u_hash~tpush(Wxiw_uc);
    int u = u_hash.keccak256_tuple() % bls::R();

    ;; ============================================
    ;; Lagrange evaluations
    ;; ============================================

    int w = 1;

<%- inverseSeedLines %>

    cell invd = invs.verifier::inverse_array(verifier::nLagrange + 1); ;; + 1 for zhinv

    cell restEvals = null();

    w = 1;

<%- lagrangeEvalLines %>

    ;; ============================================
    ;; PI (Public Input polynomial evaluation)
    ;; ============================================
    int pl = 0;

<% if (publicInputEvalLines) { -%>
<%- publicInputEvalLines %>
<% } -%>

    ;; ============================================
    ;; Compute linearization polynomial commitment
    ;; ============================================

    int e1 = pl;
    int e2 = mulmod(eval_l1, alpha2, bls::R());

    int e3a = addmod(eval_a, mulmod(beta, eval_s1, bls::R()), bls::R());
    e3a = addmod(e3a, gamma, bls::R());

    int e3b = addmod(eval_b, mulmod(beta, eval_s2, bls::R()), bls::R());
    e3b = addmod(e3b, gamma, bls::R());

    int e3c = addmod(eval_c, gamma, bls::R());

    int e3 = mulmod(mulmod(e3a, e3b, bls::R()), e3c, bls::R());
    e3 = mulmod(e3, eval_zw, bls::R());
    e3 = mulmod(e3, alpha, bls::R());

    int r0 = addmod(e1, (- e2) % bls::R(), bls::R());
    r0 = addmod(r0, (- e3) % bls::R(), bls::R());

    ;; D polynomial commitment (using compressed points for BLS ops)
    slice d1 = bls::g1_mul(verifier::Qm, mulmod(eval_a, eval_b, bls::R()));
    d1 = bls::g1_add(d1, bls::g1_mul(verifier::Ql, eval_a));
    d1 = bls::g1_add(d1, bls::g1_mul(verifier::Qr, eval_b));
    d1 = bls::g1_add(d1, bls::g1_mul(verifier::Qo, eval_c));
    d1 = bls::g1_add(d1, verifier::Qc);

    int d2a1 = addmod(addmod(eval_a, betaXi, bls::R()), gamma, bls::R());
    int d2a2 = addmod(addmod(eval_b, mulmod(betaXi, verifier::k1, bls::R()), bls::R()), gamma, bls::R());
    int d2a3 = addmod(addmod(eval_c, mulmod(betaXi, verifier::k2, bls::R()), bls::R()), gamma, bls::R());

    int d2a = mulmod(d2a1, d2a2, bls::R());
    d2a = mulmod(d2a, d2a3, bls::R());
    d2a = mulmod(d2a, alpha, bls::R());

    int d2b = mulmod(eval_l1, alpha2, bls::R());

    slice d2 = bls::g1_mul(Z, addmod(addmod(d2a, d2b, bls::R()), u, bls::R()));

    int d3a = addmod(addmod(eval_a, mulmod(beta, eval_s1, bls::R()), bls::R()), gamma, bls::R());
    int d3b = addmod(addmod(eval_b, mulmod(beta, eval_s2, bls::R()), bls::R()), gamma, bls::R());
    int d3c = mulmod(mulmod(alpha, beta, bls::R()), eval_zw, bls::R());

    slice d3 = bls::g1_mul(verifier::S3, mulmod(mulmod(d3a, d3b, bls::R()), d3c, bls::R()));

    slice d4low = T1;
    slice d4mid = bls::g1_mul(T2, xin);
    slice d4high = bls::g1_mul(T3, mulmod(xin, xin, bls::R()));
    slice d4 = bls::g1_add(d4low, bls::g1_add(d4mid, d4high));
    d4 = bls::g1_mul(d4, zh);

    slice D = bls::g1_sub(bls::g1_sub(bls::g1_add(d1, d2), d3), d4);

    ;; F polynomial commitment
    slice F = bls::g1_add(D, bls::g1_mul(A, v1));
    F = bls::g1_add(F, bls::g1_mul(B, v2));
    F = bls::g1_add(F, bls::g1_mul(C, v3));
    F = bls::g1_add(F, bls::g1_mul(verifier::S1, v4));
    F = bls::g1_add(F, bls::g1_mul(verifier::S2, v5));

    ;; E polynomial commitment
    int e = addmod((- r0) % bls::R(), mulmod(v1, eval_a, bls::R()), bls::R());
    e = addmod(e, mulmod(v2, eval_b, bls::R()), bls::R());
    e = addmod(e, mulmod(v3, eval_c, bls::R()), bls::R());
    e = addmod(e, mulmod(v4, eval_s1, bls::R()), bls::R());
    e = addmod(e, mulmod(v5, eval_s2, bls::R()), bls::R());
    e = addmod(e, mulmod(u, eval_zw, bls::R()), bls::R());

    slice E = bls::g1_mul(bls::g1, e);

    ;; ============================================
    ;; Final pairing check
    ;; ============================================

    slice A1 = Wxi;
    A1 = bls::g1_add(A1, bls::g1_mul(Wxiw, u));

    slice B1 = bls::g1_mul(Wxi, xi);
    int s = mulmod(mulmod(u, xi, bls::R()), verifier::w1, bls::R());
    B1 = bls::g1_add(B1, bls::g1_mul(Wxiw, s));
    B1 = bls::g1_add(B1, F);
    B1 = bls::g1_sub(B1, E);

    return bls::pairing(bls::g1_neg(A1), verifier::X_2, B1, bls::g2);
}

(int) verifier::verify_proof_message(slice in_msg_body) impure {
    throw_unless(verifier::err::invalid_message, slice_bits(in_msg_body) == 0);
    throw_unless(verifier::err::invalid_message, slice_refs(in_msg_body) == 1);
    slice payload = in_msg_body~load_ref().begin_parse();
    throw_unless(verifier::err::invalid_message, in_msg_body.slice_empty?());
    throw_unless(verifier::err::invalid_message, slice_bits(payload) == 0);
    throw_unless(verifier::err::invalid_message, slice_refs(payload) == 4);

    slice compressed = payload~load_ref().begin_parse();
    slice evaluations = payload~load_ref().begin_parse();
    cell public = payload~load_ref();
    slice uncompressed = payload~load_ref().begin_parse();
    throw_unless(verifier::err::invalid_message, payload.slice_empty?());
    throw_unless(verifier::err::invalid_message, slice_bits(compressed) == 0);
    throw_unless(verifier::err::invalid_message, slice_refs(compressed) == 4);
    throw_unless(verifier::err::invalid_message, slice_bits(evaluations) == 0);
    throw_unless(verifier::err::invalid_message, slice_refs(evaluations) == 2);
    throw_unless(verifier::err::invalid_message, slice_bits(uncompressed) == 0);
    throw_unless(verifier::err::invalid_message, slice_refs(uncompressed) == 4);
    verifier::validate_public_message(public);

    slice ab = compressed~load_ref().begin_parse();
    slice cz = compressed~load_ref().begin_parse();
    slice t12 = compressed~load_ref().begin_parse();
    slice compressed_tail = compressed~load_ref().begin_parse();
    throw_unless(verifier::err::invalid_message, compressed.slice_empty?());
    throw_unless(verifier::err::invalid_message, slice_bits(ab) == 768);
    throw_unless(verifier::err::invalid_message, slice_refs(ab) == 0);
    throw_unless(verifier::err::invalid_message, slice_bits(cz) == 768);
    throw_unless(verifier::err::invalid_message, slice_refs(cz) == 0);
    throw_unless(verifier::err::invalid_message, slice_bits(t12) == 768);
    throw_unless(verifier::err::invalid_message, slice_refs(t12) == 0);
    throw_unless(verifier::err::invalid_message, slice_bits(compressed_tail) == 0);
    throw_unless(verifier::err::invalid_message, slice_refs(compressed_tail) == 2);

    slice A = ab~load_bits(384);
    slice B = ab~load_bits(384);
    throw_unless(verifier::err::invalid_message, ab.slice_empty?());
    slice C = cz~load_bits(384);
    slice Z = cz~load_bits(384);
    throw_unless(verifier::err::invalid_message, cz.slice_empty?());
    slice T1 = t12~load_bits(384);
    slice T2 = t12~load_bits(384);
    throw_unless(verifier::err::invalid_message, t12.slice_empty?());

    slice t3_wxi = compressed_tail~load_ref().begin_parse();
    slice wxiw_cell = compressed_tail~load_ref().begin_parse();
    throw_unless(verifier::err::invalid_message, compressed_tail.slice_empty?());
    throw_unless(verifier::err::invalid_message, slice_bits(t3_wxi) == 768);
    throw_unless(verifier::err::invalid_message, slice_refs(t3_wxi) == 0);
    throw_unless(verifier::err::invalid_message, slice_bits(wxiw_cell) == 384);
    throw_unless(verifier::err::invalid_message, slice_refs(wxiw_cell) == 0);
    slice T3 = t3_wxi~load_bits(384);
    slice Wxi = t3_wxi~load_bits(384);
    throw_unless(verifier::err::invalid_message, t3_wxi.slice_empty?());
    slice Wxiw = wxiw_cell~load_bits(384);
    throw_unless(verifier::err::invalid_message, wxiw_cell.slice_empty?());

    slice abc = evaluations~load_ref().begin_parse();
    slice rest = evaluations~load_ref().begin_parse();
    throw_unless(verifier::err::invalid_message, evaluations.slice_empty?());
    throw_unless(verifier::err::invalid_message, slice_bits(abc) == 768);
    throw_unless(verifier::err::invalid_message, slice_refs(abc) == 0);
    throw_unless(verifier::err::invalid_message, slice_bits(rest) == 768);
    throw_unless(verifier::err::invalid_message, slice_refs(rest) == 0);
    int eval_a = abc~load_uint(256);
    int eval_b = abc~load_uint(256);
    int eval_c = abc~load_uint(256);
    throw_unless(verifier::err::invalid_message, abc.slice_empty?());
    int eval_s1 = rest~load_uint(256);
    int eval_s2 = rest~load_uint(256);
    int eval_zw = rest~load_uint(256);
    throw_unless(verifier::err::invalid_message, rest.slice_empty?());

    slice A_uc_cell = uncompressed~load_ref().begin_parse();
    slice B_uc_cell = uncompressed~load_ref().begin_parse();
    slice C_uc_cell = uncompressed~load_ref().begin_parse();
    slice uncompressed_tail = uncompressed~load_ref().begin_parse();
    throw_unless(verifier::err::invalid_message, uncompressed.slice_empty?());
    throw_unless(verifier::err::invalid_message, slice_bits(uncompressed_tail) == 0);
    throw_unless(verifier::err::invalid_message, slice_refs(uncompressed_tail) == 4);
    throw_unless(verifier::err::invalid_message, slice_bits(A_uc_cell) == 768);
    throw_unless(verifier::err::invalid_message, slice_refs(A_uc_cell) == 1);
    throw_unless(verifier::err::invalid_message, slice_bits(B_uc_cell) == 768);
    throw_unless(verifier::err::invalid_message, slice_refs(B_uc_cell) == 1);
    throw_unless(verifier::err::invalid_message, slice_bits(C_uc_cell) == 768);
    throw_unless(verifier::err::invalid_message, slice_refs(C_uc_cell) == 1);
    verifier::validate_transcript_message(A_uc_cell);
    verifier::validate_transcript_message(B_uc_cell);
    verifier::validate_transcript_message(C_uc_cell);
    slice A_uc = A_uc_cell;
    slice B_uc = B_uc_cell;
    slice C_uc = C_uc_cell;

    slice Z_uc_cell = uncompressed_tail~load_ref().begin_parse();
    slice T1_uc_cell = uncompressed_tail~load_ref().begin_parse();
    slice T2_uc_cell = uncompressed_tail~load_ref().begin_parse();
    slice uncompressed_tail2 = uncompressed_tail~load_ref().begin_parse();
    throw_unless(verifier::err::invalid_message, uncompressed_tail.slice_empty?());
    throw_unless(verifier::err::invalid_message, slice_bits(uncompressed_tail2) == 0);
    throw_unless(verifier::err::invalid_message, slice_refs(uncompressed_tail2) == 3);
    throw_unless(verifier::err::invalid_message, slice_bits(Z_uc_cell) == 768);
    throw_unless(verifier::err::invalid_message, slice_refs(Z_uc_cell) == 1);
    throw_unless(verifier::err::invalid_message, slice_bits(T1_uc_cell) == 768);
    throw_unless(verifier::err::invalid_message, slice_refs(T1_uc_cell) == 1);
    throw_unless(verifier::err::invalid_message, slice_bits(T2_uc_cell) == 768);
    throw_unless(verifier::err::invalid_message, slice_refs(T2_uc_cell) == 1);
    verifier::validate_transcript_message(Z_uc_cell);
    verifier::validate_transcript_message(T1_uc_cell);
    verifier::validate_transcript_message(T2_uc_cell);
    slice Z_uc = Z_uc_cell;
    slice T1_uc = T1_uc_cell;
    slice T2_uc = T2_uc_cell;

    slice T3_uc_cell = uncompressed_tail2~load_ref().begin_parse();
    slice Wxi_uc_cell = uncompressed_tail2~load_ref().begin_parse();
    slice Wxiw_uc_cell = uncompressed_tail2~load_ref().begin_parse();
    throw_unless(verifier::err::invalid_message, uncompressed_tail2.slice_empty?());
    throw_unless(verifier::err::invalid_message, slice_bits(T3_uc_cell) == 768);
    throw_unless(verifier::err::invalid_message, slice_refs(T3_uc_cell) == 1);
    throw_unless(verifier::err::invalid_message, slice_bits(Wxi_uc_cell) == 768);
    throw_unless(verifier::err::invalid_message, slice_refs(Wxi_uc_cell) == 1);
    throw_unless(verifier::err::invalid_message, slice_bits(Wxiw_uc_cell) == 768);
    throw_unless(verifier::err::invalid_message, slice_refs(Wxiw_uc_cell) == 1);
    verifier::validate_transcript_message(T3_uc_cell);
    verifier::validate_transcript_message(Wxi_uc_cell);
    verifier::validate_transcript_message(Wxiw_uc_cell);
    slice T3_uc = T3_uc_cell;
    slice Wxi_uc = Wxi_uc_cell;
    slice Wxiw_uc = Wxiw_uc_cell;

    int ok = verify(
        A, B, C, Z, T1, T2, T3,
        eval_a, eval_b, eval_c, eval_s1, eval_s2, eval_zw,
        Wxi, Wxiw,
        public,
        A_uc, B_uc, C_uc, Z_uc, T1_uc, T2_uc, T3_uc, Wxi_uc, Wxiw_uc
    );
    return ok;
}

() recv_internal(int msg_value, cell in_msg_full, slice in_msg_body) impure {
    if (in_msg_body.slice_empty?()) {
        return ();
    }
    slice cs = in_msg_full.begin_parse();
    int flags = cs~load_uint(4);
    if (flags & 1) {
        return ();
    }
    throw_unless(
        verifier::err::invalid_message,
        slice_bits(in_msg_body) >= 32
    );
    int op = in_msg_body~load_uint(32);

    if (op == op::verify) {
        throw_unless(verifier::err::not_enough_value, msg_value >= verifier::minVerifyValue);
        throw_unless(verifier::err::invalid_proof, verifier::verify_proof_message(in_msg_body));
        return ();
    }
    throw(0xffff);
}
