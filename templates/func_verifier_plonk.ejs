const nLagrange = Math.max(nPublic, 1);
const xinSquares = Array.from(
  { length: power },
  () => "    xin = mulmod(xin, xin, bls::R());",
).join("\n");
const inverseSeedLines = Array.from({ length: nLagrange }, (_, index) => {
  const i = index + 1;
  const lines = [
    `    invs~verifier::set_arr(${i}, mulmod(verifier::domainSize, (xi - w) % bls::R(), bls::R()));`,
  ];
